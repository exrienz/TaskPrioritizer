# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=task_prioritizer
DB_USER=taskuser
DB_PASS=secure_password_123

# Google OAuth Configuration
# Set to 'true' to enable Google OAuth login, 'false' to disable
GOOGLE_OAUTH_ENABLED=false

# Get these credentials from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select existing one
# 3. Navigate to "APIs & Services" > "Credentials"
# 4. Create OAuth 2.0 Client ID (Web application)
# 5. Add authorized redirect URIs (e.g., https://yourdomain.com/index.php)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# The redirect URI must match exactly what you configured in Google Cloud Console
# For local development: http://localhost:8080/index.php
# For production: https://yourdomain.com/index.php
GOOGLE_REDIRECT_URI=http://localhost:8080/index.php
